# Reconcile infrastructure with:
# pnpm exec hot-updater init --provider cloudflare --build expo --from-env-file .env.hotupdater
HOT_UPDATER_INIT_BUILD=expo
HOT_UPDATER_INIT_PROVIDER=cloudflare

# Public client endpoint. This value is embedded in the app bundle; it is not a secret.
HOT_UPDATER_BASE_URL=https://hot-updater.jinjinstar3.workers.dev/api/check-update

# Cloudflare credentials and resource identifiers. Never commit real values.
HOT_UPDATER_CLOUDFLARE_ACCOUNT_ID=
HOT_UPDATER_CLOUDFLARE_API_TOKEN=
HOT_UPDATER_CLOUDFLARE_R2_BUCKET_NAME=ch-notes-bucket
HOT_UPDATER_CLOUDFLARE_R2_ACCESS_KEY_ID=
HOT_UPDATER_CLOUDFLARE_R2_SECRET_ACCESS_KEY=
HOT_UPDATER_CLOUDFLARE_WORKER_NAME=hot-updater
HOT_UPDATER_CLOUDFLARE_D1_DATABASE_ID=
HOT_UPDATER_CLOUDFLARE_D1_DATABASE_NAME=ch-notes
HOT_UPDATER_CLOUDFLARE_R2_PRIVATE=true
